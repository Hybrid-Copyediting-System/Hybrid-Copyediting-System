# Copy to .env and tweak as needed. .env is gitignored.

# Port the FastAPI server (and the SPA it serves) listens on.
ETS_PORT=47823

# Comma-separated list of allowed CORS origins for the API. Leave blank to
# disable CORS (only same-origin requests are allowed). Example:
#   ETS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
#ETS_CORS_ORIGINS=
